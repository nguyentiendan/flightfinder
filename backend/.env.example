# Chua co key -> backend tu chay mock (da thong nhat voi user).
# Khi anh gui key, dien vao day (ca chay local va docker-compose deu doc file nay).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Empty Amadeus id or secret uses mock offers and does not call the network.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com
