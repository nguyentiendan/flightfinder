# No API key yet: the backend runs in mock mode.
# When you have a key, put it here (local runs and docker-compose both read this file).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Empty Amadeus id or secret uses mock offers and does not call the network.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com
